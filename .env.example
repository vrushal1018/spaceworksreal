# Copy to .env.local and fill in. Nothing here is required to run locally.
NEXT_PUBLIC_SITE_URL=https://inaspaceworks.com

# Email (contact enquiries and CV receipts). Without SMTP_HOST, emails are printed to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ina SpaceWorks <evolve@inaspaceworks.com>"
MAIL_TO=evolve@inaspaceworks.com

# Where applications and CV files are kept (default: ./data, outside the public folder)
DATA_DIR=./data

# /admin/careers login (HTTP basic auth). The admin pages are closed if these are empty.
ADMIN_USER=
ADMIN_PASS=
